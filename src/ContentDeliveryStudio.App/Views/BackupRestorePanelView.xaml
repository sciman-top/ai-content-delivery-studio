<UserControl x:Class="ContentDeliveryStudio.App.Views.BackupRestorePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="{Binding SafetySummary}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Margin="0,0,0,10" />

        <TextBlock Text="{Binding BackupSourceDirectoryLabel}" Margin="0,0,0,4" />
        <TextBox Text="{Binding BackupSourceDirectory, Mode=OneWay}"
                 IsReadOnly="True"
                 MinHeight="28"
                 automation:AutomationProperties.AutomationId="BackupSourceDirectory"
                 automation:AutomationProperties.Name="{Binding BackupSourceDirectoryLabel}"
                 FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />
        <Button Content="{Binding BrowseBackupSourceText}"
                Command="{Binding BrowseBackupSourceCommand}"
                MinHeight="30"
                Margin="0,6,0,8"
                automation:AutomationProperties.AutomationId="BrowseBackupSourceDirectory"
                automation:AutomationProperties.Name="{Binding BrowseBackupSourceText}"
                FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />

        <TextBlock Text="{Binding BackupDestinationFileLabel}" Margin="0,0,0,4" />
        <TextBox Text="{Binding BackupFilePath, Mode=OneWay}"
                 IsReadOnly="True"
                 MinHeight="28"
                 automation:AutomationProperties.AutomationId="BackupDestinationFile"
                 automation:AutomationProperties.Name="{Binding BackupDestinationFileLabel}"
                 FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />
        <UniformGrid Columns="2" Margin="0,6,0,12">
            <Button Content="{Binding BrowseBackupDestinationText}"
                    Command="{Binding BrowseBackupDestinationCommand}"
                    MinHeight="30"
                    Margin="0,0,4,0"
                    automation:AutomationProperties.AutomationId="BrowseBackupDestinationFile"
                    automation:AutomationProperties.Name="{Binding BrowseBackupDestinationText}"
                    FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />
            <Button Content="{Binding CreateBackupText}"
                    Command="{Binding CreateBackupCommand}"
                    MinHeight="30"
                    Margin="4,0,0,0"
                    automation:AutomationProperties.AutomationId="CreateSafeBackup"
                    automation:AutomationProperties.Name="{Binding CreateBackupText}"
                    FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />
        </UniformGrid>

        <TextBlock Text="{Binding RestoreBackupFileLabel}" Margin="0,0,0,4" />
        <TextBox Text="{Binding RestoreBackupFilePath, Mode=OneWay}"
                 IsReadOnly="True"
                 MinHeight="28"
                 automation:AutomationProperties.AutomationId="RestoreBackupFile"
                 automation:AutomationProperties.Name="{Binding RestoreBackupFileLabel}"
                 FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />
        <Button Content="{Binding BrowseRestoreBackupText}"
                Command="{Binding BrowseRestoreBackupCommand}"
                MinHeight="30"
                Margin="0,6,0,8"
                automation:AutomationProperties.AutomationId="BrowseRestoreBackupFile"
                automation:AutomationProperties.Name="{Binding BrowseRestoreBackupText}"
                FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />

        <TextBlock Text="{Binding RestoreTargetDirectoryLabel}" Margin="0,0,0,4" />
        <TextBox Text="{Binding RestoreTargetDirectory, Mode=OneWay}"
                 IsReadOnly="True"
                 MinHeight="28"
                 automation:AutomationProperties.AutomationId="RestoreTargetDirectory"
                 automation:AutomationProperties.Name="{Binding RestoreTargetDirectoryLabel}"
                 FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />
        <UniformGrid Columns="2" Margin="0,6,0,8">
            <Button Content="{Binding BrowseRestoreTargetText}"
                    Command="{Binding BrowseRestoreTargetCommand}"
                    MinHeight="30"
                    Margin="0,0,4,0"
                    automation:AutomationProperties.AutomationId="BrowseRestoreTargetDirectory"
                    automation:AutomationProperties.Name="{Binding BrowseRestoreTargetText}"
                    FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />
            <Button Content="{Binding RestoreBackupText}"
                    Command="{Binding RestoreBackupCommand}"
                    MinHeight="30"
                    Margin="4,0,0,0"
                    automation:AutomationProperties.AutomationId="RestoreSafeBackup"
                    automation:AutomationProperties.Name="{Binding RestoreBackupText}"
                    FocusVisualStyle="{StaticResource AccessibleKeyboardFocusVisual}" />
        </UniformGrid>

        <TextBlock Text="{Binding StatusText}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   automation:AutomationProperties.AutomationId="BackupRestoreStatus"
                   automation:AutomationProperties.Name="{Binding StatusText}"
                   automation:AutomationProperties.LiveSetting="Polite"
                   KeyboardNavigation.IsTabStop="False"
                   Focusable="False" />
    </StackPanel>
</UserControl>
