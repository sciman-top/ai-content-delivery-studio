<UserControl x:Class="ContentDeliveryStudio.App.Views.ScientificDeliveryWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6">
            <TextBlock Text="{Binding ScientificDelivery.FormatsTitle}"
                       FontWeight="SemiBold"
                       FontSize="15" />
            <ListBox Height="118"
                     Margin="0,6,0,0"
                     ItemsSource="{Binding ScientificDelivery.Artifacts}"
                     SelectedItem="{Binding ScientificDelivery.SelectedArtifact, Mode=TwoWay}"
                     automation:AutomationProperties.AutomationId="ScientificDeliveryFormatList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Format}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MimeType}" Foreground="#4D5B6A" />
                            <TextBlock Text="{Binding Sha256}" Foreground="#4D5B6A" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Height="150"
                    Margin="0,6,0,0"
                    BorderBrush="#D9DEE8"
                    BorderThickness="1">
                <Grid>
                    <Image x:Name="PngPreview"
                           Stretch="Uniform"
                           automation:AutomationProperties.AutomationId="ScientificDeliveryPngPreview" />
                    <StackPanel VerticalAlignment="Center" Margin="12">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScientificDelivery.SelectedArtifact.IsPng}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding ScientificDelivery.SelectedArtifact.Format}"
                                   HorizontalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ScientificDelivery.SelectedArtifact.SourceSvgSha256}"
                                   Margin="0,6,0,0"
                                   Foreground="#4D5B6A"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ScientificDelivery.SelectedArtifact.SemanticSha256}"
                                   Foreground="#4D5B6A"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding ScientificDelivery.ReviewStatusTitle}"
                       FontWeight="SemiBold" />
            <TextBlock Foreground="#4D5B6A" TextWrapping="Wrap">
                <Run Text="{Binding ScientificDelivery.ContractStatusLabel, Mode=OneWay}" />
                <Run Text=": " />
                <Run Text="{Binding ScientificDelivery.ContractReviewPassed, Mode=OneWay}" />
                <Run Text=" / " />
                <Run Text="{Binding ScientificDelivery.MachineStatusLabel, Mode=OneWay}" />
                <Run Text=": " />
                <Run Text="{Binding ScientificDelivery.MachineReviewPassed, Mode=OneWay}" />
                <Run Text=" / " />
                <Run Text="{Binding ScientificDelivery.RepairCountLabel, Mode=OneWay}" />
                <Run Text=": " />
                <Run Text="{Binding ScientificDelivery.RepairCount, Mode=OneWay}" />
            </TextBlock>
            <ItemsControl ItemsSource="{Binding ScientificDelivery.UnresolvedIssues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#A33A2B" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding ScientificDelivery.EvidenceChainTitle}"
                       FontWeight="SemiBold" />
            <ListBox Height="100"
                     Margin="0,4,0,0"
                     ItemsSource="{Binding ScientificDelivery.EvidenceItems}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding SpecificationItemId}" FontWeight="SemiBold" />
                            <TextBlock Foreground="#4D5B6A" TextWrapping="Wrap">
                                <Run Text="{Binding ClaimId, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding SourceBlockId, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding QuotedText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ScientificDelivery.Providers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Foreground="#4D5B6A" TextWrapping="Wrap">
                            <Run Text="{Binding Layer, Mode=OneWay}" />
                            <Run Text=": " />
                            <Run Text="{Binding ProviderId, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding ModelId, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,10,0,0"
                       Text="{Binding ScientificDelivery.GateTwoTitle}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,2" Text="{Binding ScientificDelivery.ReviewerLabel}" />
            <TextBox Text="{Binding ScientificDelivery.GateTwoReviewer, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,5,0,2" Text="{Binding ScientificDelivery.NotesLabel}" />
            <TextBox MinHeight="42"
                     Text="{Binding ScientificDelivery.GateTwoNotes, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Margin="0,0,3,0"
                        Padding="10,5"
                        Content="{Binding ScientificDelivery.ApproveGateTwoText}"
                        Command="{Binding ScientificDelivery.ApproveGateTwoCommand}"
                        automation:AutomationProperties.AutomationId="ApproveScientificGateTwo" />
                <Button Grid.Column="1"
                        Margin="3,0,0,0"
                        Padding="10,5"
                        Content="{Binding ScientificDelivery.RejectGateTwoText}"
                        Command="{Binding ScientificDelivery.RejectGateTwoCommand}"
                        automation:AutomationProperties.AutomationId="RejectScientificGateTwo" />
            </Grid>
            <Button Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Padding="12,5"
                    Content="{Binding ScientificDelivery.ExportPackageText}"
                    Command="{Binding ScientificDelivery.ExportPackageCommand}"
                    automation:AutomationProperties.AutomationId="ExportScientificDeliveryPackage" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
