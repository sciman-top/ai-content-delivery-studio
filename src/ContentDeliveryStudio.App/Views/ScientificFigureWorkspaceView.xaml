<UserControl x:Class="ContentDeliveryStudio.App.Views.ScientificFigureWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             mc:Ignorable="d"
             MinWidth="460"
             MinHeight="360"
             UseLayoutRounding="True">
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsScientificFigure}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderBrush="#D9DEE8"
                BorderThickness="0,0,1,0"
                Padding="12"
                automation:AutomationProperties.AutomationId="ScientificSourceWorkspace"
                automation:AutomationProperties.Name="{Binding ScientificWorkspace.Workspaces[0].Title}">
            <StackPanel>
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[0].Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[0].StatusText}" Margin="0,8,0,0" Foreground="#4D5B6A" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Column="1"
                BorderBrush="#D9DEE8"
                BorderThickness="0,0,1,0"
                Padding="12"
                automation:AutomationProperties.AutomationId="ScientificUnderstandingWorkspace"
                automation:AutomationProperties.Name="{Binding ScientificWorkspace.Workspaces[1].Title}">
            <StackPanel>
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[1].Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[1].StatusText}" Margin="0,8,0,0" Foreground="#4D5B6A" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Column="2"
                BorderBrush="#D9DEE8"
                BorderThickness="0,0,1,0"
                Padding="12"
                automation:AutomationProperties.AutomationId="ScientificFigureSpecWorkspace"
                automation:AutomationProperties.Name="{Binding ScientificWorkspace.Workspaces[2].Title}">
            <StackPanel>
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[2].Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[2].StatusText}" Margin="0,8,0,0" Foreground="#4D5B6A" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Column="3"
                BorderBrush="#D9DEE8"
                BorderThickness="0,0,1,0"
                Padding="12"
                automation:AutomationProperties.AutomationId="ScientificRenderReviewWorkspace"
                automation:AutomationProperties.Name="{Binding ScientificWorkspace.Workspaces[3].Title}">
            <StackPanel>
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[3].Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[3].StatusText}" Margin="0,8,0,0" Foreground="#4D5B6A" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Column="4"
                Padding="12"
                automation:AutomationProperties.AutomationId="ScientificDeliveryWorkspace"
                automation:AutomationProperties.Name="{Binding ScientificWorkspace.Workspaces[4].Title}">
            <StackPanel>
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[4].Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[4].StatusText}" Margin="0,8,0,0" Foreground="#4D5B6A" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
