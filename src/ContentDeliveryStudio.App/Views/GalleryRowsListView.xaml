<UserControl x:Class="ContentDeliveryStudio.App.Views.GalleryRowsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:ContentDeliveryStudio.App.Services"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <services:GalleryThumbnailPathConverter x:Key="GalleryThumbnailPathConverter" />
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1,0,1,1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.ImageSeries.HasGalleryRows, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <ListBox ItemsSource="{Binding DataContext.ImageSeries.GalleryRows, RelativeSource={RelativeSource AncestorType=TabControl}}"
                 SelectedItem="{Binding DataContext.ImageSeries.SelectedGalleryRow, RelativeSource={RelativeSource AncestorType=TabControl}, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 SelectionMode="Single"
                 automation:AutomationProperties.AutomationId="GalleryCandidateList"
                 automation:AutomationProperties.Name="{Binding DataContext.ImageSeries.GalleryItemColumn, RelativeSource={RelativeSource AncestorType=TabControl}}"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.IsDeferredScrollingEnabled="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource AccessibleKeyboardFocusVisual}" />
                    <Setter Property="automation:AutomationProperties.Name" Value="{Binding ItemTitle}" />
                    <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="2.3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ItemTitle}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1"
                                    Width="112"
                                    Height="84"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                    BorderThickness="1"
                                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                    Margin="10,0,0,0">
                                <Image Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Source>
                                        <Binding Path="AssetPath"
                                                 Converter="{StaticResource GalleryThumbnailPathConverter}"
                                                 IsAsync="True" />
                                    </Image.Source>
                                </Image>
                            </Border>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding AssetPath}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                                <TextBlock Text="{Binding MetadataPath}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Border>
</UserControl>
