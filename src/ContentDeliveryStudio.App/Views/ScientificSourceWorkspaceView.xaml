<UserControl x:Class="ContentDeliveryStudio.App.Views.ScientificSourceWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid Margin="0,12,6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="{Binding ScientificSourceUnderstanding.SourceTitle}" FontWeight="SemiBold" FontSize="15" />
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding ScientificSourceUnderstanding.ExtractionStatus}"
                       Foreground="#4D5B6A" />
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="{Binding ScientificSourceUnderstanding.DiagnosticsTitle}" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding ScientificSourceUnderstanding.Diagnostics}"
                          automation:AutomationProperties.AutomationId="ScientificExtractionDiagnostics">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Message}" Foreground="#4D5B6A" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ItemsControl Grid.Row="2"
                      Margin="0,8,0,8"
                      ItemsSource="{Binding ScientificSourceUnderstanding.BlockingReasons}"
                      automation:AutomationProperties.AutomationId="ScientificExtractionBlocks">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#A33A2B" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="3"
                   Text="{Binding ScientificSourceUnderstanding.SourceBlocksTitle}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <ListBox Grid.Row="4"
                 ItemsSource="{Binding ScientificSourceUnderstanding.SourceBlocks}"
                 SelectedItem="{Binding ScientificSourceUnderstanding.SelectedSourceBlock, Mode=TwoWay}"
                 automation:AutomationProperties.AutomationId="ScientificSourceBlockList"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding BlockId}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Section}" Foreground="#4D5B6A" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OriginalText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
