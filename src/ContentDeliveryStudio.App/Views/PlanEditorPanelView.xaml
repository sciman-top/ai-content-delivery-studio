<UserControl x:Class="ContentDeliveryStudio.App.Views.PlanEditorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="{Binding ImageSeriesWorkspace.Planning.PlanEditorTitle}" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBlock Text="{Binding ImageSeriesWorkspace.Planning.SeriesTitleLabel}" Margin="0,0,0,4" />
        <TextBox Text="{Binding ImageSeriesWorkspace.Planning.NewSeriesTitle, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="SeriesTitleInput"
                 AutomationProperties.Name="{Binding ImageSeriesWorkspace.Planning.SeriesTitleLabel}"
                 Margin="0,0,0,6" />
        <TextBlock Text="{Binding ImageSeriesWorkspace.Planning.SeriesDescriptionLabel}" Margin="0,0,0,4" />
        <TextBox Text="{Binding ImageSeriesWorkspace.Planning.NewSeriesDescription, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="SeriesDescriptionInput"
                 AutomationProperties.Name="{Binding ImageSeriesWorkspace.Planning.SeriesDescriptionLabel}"
                 Margin="0,0,0,8" />
        <Button Content="{Binding ImageSeriesWorkspace.Planning.CreateSeriesText}"
                Command="{Binding ImageSeriesWorkspace.Planning.CreateSeriesCommand}"
                AutomationProperties.AutomationId="CreateSeriesButton"
                AutomationProperties.Name="{Binding ImageSeriesWorkspace.Planning.CreateSeriesText}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,12" />

        <TextBlock Text="{Binding ImageSeriesWorkspace.Planning.AvailableSeriesTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding ImageSeriesWorkspace.Planning.Series}"
                 SelectedItem="{Binding ImageSeriesWorkspace.Planning.SelectedSeries, Mode=TwoWay}"
                 DisplayMemberPath="Title"
                 AutomationProperties.AutomationId="AvailableSeriesList"
                 AutomationProperties.Name="{Binding ImageSeriesWorkspace.Planning.AvailableSeriesTitle}"
                 MinHeight="82"
                 Margin="0,0,0,12" />

        <TextBlock Text="{Binding ImageSeriesWorkspace.Planning.ItemTitleLabel}" Margin="0,0,0,4" />
        <TextBox Text="{Binding ImageSeriesWorkspace.Planning.NewItemTitle, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="SeriesItemTitleInput"
                 AutomationProperties.Name="{Binding ImageSeriesWorkspace.Planning.ItemTitleLabel}"
                 Margin="0,0,0,6" />
        <TextBlock Text="{Binding ImageSeriesWorkspace.Planning.ItemBriefLabel}" Margin="0,0,0,4" />
        <TextBox Text="{Binding ImageSeriesWorkspace.Planning.NewItemBrief, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="SeriesItemBriefInput"
                 AutomationProperties.Name="{Binding ImageSeriesWorkspace.Planning.ItemBriefLabel}"
                 Margin="0,0,0,8" />
        <Button Content="{Binding ImageSeriesWorkspace.Planning.AddItemText}"
                Command="{Binding ImageSeriesWorkspace.Planning.AddItemCommand}"
                AutomationProperties.AutomationId="AddSeriesItemButton"
                AutomationProperties.Name="{Binding ImageSeriesWorkspace.Planning.AddItemText}"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,12" />

        <TextBlock Text="{Binding ImageSeriesWorkspace.Planning.SeriesItemsTitle}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding ImageSeriesWorkspace.Planning.SeriesItems}"
                 SelectedItem="{Binding ImageSeriesWorkspace.Planning.SelectedSeriesItem, Mode=TwoWay}"
                 DisplayMemberPath="Title"
                 AutomationProperties.AutomationId="SeriesItemsList"
                 AutomationProperties.Name="{Binding ImageSeriesWorkspace.Planning.SeriesItemsTitle}"
                 MinHeight="82" />
    </StackPanel>
</UserControl>
