<UserControl x:Class="ContentDeliveryStudio.App.Views.ScientificRenderReviewWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6">
            <DockPanel>
                <TextBlock Text="{Binding ScientificRenderReview.PreviewTitle}"
                           FontWeight="SemiBold"
                           FontSize="15" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="28" Height="28"
                            Content="-"
                            Command="{Binding ScientificRenderReview.ZoomOutCommand}" />
                    <Slider Width="82"
                            Margin="5,0"
                            Minimum="0.5"
                            Maximum="2"
                            TickFrequency="0.1"
                            Value="{Binding ScientificRenderReview.ZoomScale, Mode=TwoWay}" />
                    <Button Width="28" Height="28"
                            Content="+"
                            Command="{Binding ScientificRenderReview.ZoomInCommand}" />
                </StackPanel>
            </DockPanel>
            <Border Height="190"
                    Margin="0,6,0,0"
                    BorderBrush="#D9DEE8"
                    BorderThickness="1">
                <WebBrowser x:Name="SvgBrowser"
                            automation:AutomationProperties.AutomationId="ScientificSvgPreview"
                            automation:AutomationProperties.Name="{Binding ScientificRenderReview.PreviewTitle}" />
            </Border>
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding ScientificRenderReview.AuthorityItemsTitle}"
                       FontWeight="SemiBold" />
            <ListBox Height="95"
                     Margin="0,4,0,0"
                     ItemsSource="{Binding ScientificRenderReview.SvgItems}"
                     SelectedItem="{Binding ScientificRenderReview.SelectedSvgItem, Mode=TwoWay}"
                     automation:AutomationProperties.AutomationId="ScientificSvgAuthorityItems"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding SpecificationItemId}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ScientificMeaning}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding ScientificRenderReview.ProvenanceTitle}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ScientificRenderReview.SelectedProvenance.ClaimStatement}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScientificRenderReview.SelectedProvenance.ExactQuote}"
                           Foreground="#4D5B6A"
                           TextWrapping="Wrap" />
                <TextBlock Foreground="#4D5B6A">
                    <Run Text="{Binding ScientificRenderReview.SelectedProvenance.SourceBlockId, Mode=OneWay}" />
                    <Run Text=" / " />
                    <Run Text="{Binding ScientificRenderReview.SelectedProvenance.Section, Mode=OneWay}" />
                    <Run Text=" / p." />
                    <Run Text="{Binding ScientificRenderReview.SelectedProvenance.PageNumber, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <Expander Margin="0,8,0,0"
                      Header="{Binding ScientificRenderReview.ContractFindingsTitle}"
                      IsExpanded="True">
                <ItemsControl ItemsSource="{Binding ScientificRenderReview.ContractFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2" Foreground="#A33A2B" TextWrapping="Wrap">
                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=": " />
                                <Run Text="{Binding Evidence, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
            <Expander Header="{Binding ScientificRenderReview.SemanticFindingsTitle}">
                <ItemsControl ItemsSource="{Binding ScientificRenderReview.SemanticFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2" Foreground="#A33A2B" Text="{Binding Evidence}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
            <Expander Header="{Binding ScientificRenderReview.VisualFindingsTitle}">
                <ItemsControl ItemsSource="{Binding ScientificRenderReview.VisualFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,2" Foreground="#A33A2B" Text="{Binding Evidence}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding ScientificRenderReview.RepairActionsTitle}"
                       FontWeight="SemiBold" />
            <ListBox Height="90"
                     Margin="0,4,0,0"
                     ItemsSource="{Binding ScientificRenderReview.RepairActions}"
                     SelectedItem="{Binding ScientificRenderReview.SelectedRepairAction, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding FindingCode, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Layer, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ExecutionMode}" Foreground="#4D5B6A" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Padding="12,5"
                    Content="{Binding ScientificRenderReview.RunAutomaticRepairText}"
                    Command="{Binding ScientificRenderReview.RunAutomaticRepairCommand}"
                    automation:AutomationProperties.AutomationId="RunAuthorizedScientificRepair" />
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding ScientificRenderReview.RepairHistoryTitle}"
                       FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding ScientificRenderReview.RepairHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding Attempt, Mode=OneWay}" />
                            <Run Text=". " />
                            <Run Text="{Binding FindingCode, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding Layer, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
