<UserControl x:Class="ContentDeliveryStudio.App.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ContentDeliveryStudio.App.Views"
             mc:Ignorable="d">
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsQueue}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F5F7FA"
                BorderBrush="#D4DAE5"
                BorderThickness="1,1,1,0"
                Padding="8">
            <WrapPanel Orientation="Horizontal">
                <Button Content="{Binding DataContext.ExecuteGenerationQueueText, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        Command="{Binding DataContext.ExecutePreparedGenerationQueueCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        AutomationProperties.AutomationId="QueueExecuteButton"
                        MinWidth="104"
                        Margin="0,0,8,0" />
                <Button Content="{Binding DataContext.PauseGenerationTaskText, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        Command="{Binding DataContext.PauseSelectedGenerationTaskCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        AutomationProperties.AutomationId="QueuePauseButton"
                        MinWidth="76"
                        Margin="0,0,8,0" />
                <Button Content="{Binding DataContext.ResumeGenerationTaskText, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        Command="{Binding DataContext.ResumeSelectedGenerationTaskCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        AutomationProperties.AutomationId="QueueResumeButton"
                        MinWidth="76"
                        Margin="0,0,8,0" />
                <Button Content="{Binding DataContext.RetryGenerationTaskText, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        Command="{Binding DataContext.RetrySelectedGenerationTaskCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        AutomationProperties.AutomationId="QueueRetryButton"
                        MinWidth="76"
                        Margin="0,0,8,0" />
                <Button Content="{Binding DataContext.MoveGenerationTaskUpText, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        Command="{Binding DataContext.MoveSelectedGenerationTaskUpCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        AutomationProperties.AutomationId="QueueMoveUpButton"
                        MinWidth="76"
                        Margin="0,0,8,0" />
                <Button Content="{Binding DataContext.MoveGenerationTaskDownText, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        Command="{Binding DataContext.MoveSelectedGenerationTaskDownCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                        AutomationProperties.AutomationId="QueueMoveDownButton"
                        MinWidth="76" />
            </WrapPanel>
        </Border>

        <views:QueueHeaderView Grid.Row="1" />

        <TextBlock Grid.Row="2"
                   Text="{Binding DataContext.NoQueueRowsText, RelativeSource={RelativeSource AncestorType=TabControl}}"
                   Foreground="#5E6978"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsQueue}" Value="True" />
                                <Condition Binding="{Binding DataContext.HasQueueRows, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <views:QueueRowsListView Grid.Row="3" />
    </Grid>
</UserControl>
