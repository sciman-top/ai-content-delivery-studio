<UserControl x:Class="ContentDeliveryStudio.App.Views.ScientificFigureSpecWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer Margin="6,12,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <DockPanel>
                <TextBlock Text="{Binding ScientificWorkspace.Workspaces[2].Title}"
                           FontWeight="SemiBold"
                           FontSize="15" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ScientificFigureSpec.RiskLevel}"
                           Foreground="#4D5B6A" />
            </DockPanel>
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding ScientificFigureSpec.CentralMessage}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding ScientificFigureSpec.ElementsTitle}"
                       FontWeight="SemiBold" />
            <ListBox Height="105"
                     Margin="0,4,0,0"
                     ItemsSource="{Binding ScientificFigureSpec.Elements}"
                     automation:AutomationProperties.AutomationId="ScientificFigureElementList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding ItemId}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ScientificMeaning}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ExactQuote}" Foreground="#4D5B6A" TextWrapping="Wrap" />
                            <TextBlock Foreground="#4D5B6A">
                                <Run Text="{Binding ClaimId}" />
                                <Run Text=" / " />
                                <Run Text="{Binding SourceBlockId}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding ScientificFigureSpec.RelationsTitle}"
                       FontWeight="SemiBold" />
            <ListBox Height="90"
                     Margin="0,4,0,0"
                     ItemsSource="{Binding ScientificFigureSpec.Relations}"
                     automation:AutomationProperties.AutomationId="ScientificFigureRelationList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding ItemId}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Kind}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ConventionStatement}" Foreground="#4D5B6A" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding ScientificFigureSpec.ProposalsTitle}"
                       FontWeight="SemiBold" />
            <ListBox Height="110"
                     Margin="0,4,0,0"
                     ItemsSource="{Binding ScientificFigureSpec.Proposals}"
                     SelectedItem="{Binding ScientificFigureSpec.SelectedProposal, Mode=TwoWay}"
                     automation:AutomationProperties.AutomationId="ScientificFigureProposalDiffs"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding TargetId}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Field}" />
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentValue}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProposedValue}" Foreground="#245D3A" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Decision}" Foreground="#4D5B6A" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <Button Padding="10,4"
                        Content="{Binding ScientificFigureSpec.AcceptProposalText}"
                        Command="{Binding ScientificFigureSpec.AcceptProposalCommand}" />
                <Button Margin="6,0,0,0"
                        Padding="10,4"
                        Content="{Binding ScientificFigureSpec.RejectProposalText}"
                        Command="{Binding ScientificFigureSpec.RejectProposalCommand}" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0"
                       Text="{Binding ScientificFigureSpec.GateOneTitle}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,3,0,0" Foreground="#4D5B6A" TextWrapping="Wrap">
                <Run Text="{Binding ScientificFigureSpec.UnderstandingVersionLabel}" />
                <Run Text=": " />
                <Run Text="{Binding ScientificFigureSpec.UnderstandingVersion}" />
                <Run Text=" / " />
                <Run Text="{Binding ScientificFigureSpec.SpecificationVersionLabel}" />
                <Run Text=": " />
                <Run Text="{Binding ScientificFigureSpec.SpecificationVersion}" />
            </TextBlock>
            <ItemsControl Margin="0,4,0,0"
                          ItemsSource="{Binding ScientificFigureSpec.GateOneBlockingReasons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#A33A2B" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,5,0,2" Text="{Binding ScientificFigureSpec.ReviewerLabel}" />
            <TextBox Text="{Binding ScientificFigureSpec.GateOneReviewer, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,5,0,2" Text="{Binding ScientificFigureSpec.NotesLabel}" />
            <TextBox MinHeight="42"
                     Text="{Binding ScientificFigureSpec.GateOneNotes, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True" />
            <Button Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Padding="12,5"
                    Content="{Binding ScientificFigureSpec.ApproveGateOneText}"
                    Command="{Binding ScientificFigureSpec.ApproveGateOneCommand}"
                    automation:AutomationProperties.AutomationId="ApproveScientificGateOne" />
            <TextBlock Margin="0,6,0,0" Foreground="#245D3A" TextWrapping="Wrap">
                <Run Text="{Binding ScientificFigureSpec.FrozenVersionsTitle}" />
                <Run Text=": " />
                <Run Text="{Binding ScientificFigureSpec.FrozenUnderstandingVersion}" />
                <Run Text=" / " />
                <Run Text="{Binding ScientificFigureSpec.FrozenSpecificationVersion}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
