<UserControl x:Class="ContentDeliveryStudio.App.Views.StyleRecipeInspectorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="{Binding ImageSeriesWorkspace.GenerationSettings.StyleRecipeInspectorTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="{Binding ImageSeriesWorkspace.GenerationSettings.ImageTypePresetLabel}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding ImageSeriesWorkspace.GenerationSettings.ImageTypePresetOptions}"
                  SelectedItem="{Binding ImageSeriesWorkspace.GenerationSettings.SelectedImageTypePresetOption, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName"
                  AutomationProperties.AutomationId="ImageTypePresetSelector"
                  AutomationProperties.Name="{Binding ImageSeriesWorkspace.GenerationSettings.ImageTypePresetLabel}"
                  MinHeight="28"
                  Margin="0,0,0,6" />
        <TextBlock Text="{Binding ImageSeriesWorkspace.GenerationSettings.StyleGuideLabel}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding ImageSeriesWorkspace.GenerationSettings.StyleGuideOptions}"
                  SelectedItem="{Binding ImageSeriesWorkspace.GenerationSettings.SelectedStyleGuideOption, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  AutomationProperties.AutomationId="StyleGuideSelector"
                  AutomationProperties.Name="{Binding ImageSeriesWorkspace.GenerationSettings.StyleGuideLabel}"
                  MinHeight="28"
                  Margin="0,0,0,6" />
        <TextBlock Text="{Binding ImageSeriesWorkspace.GenerationSettings.GenerationRecipeLabel}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding ImageSeriesWorkspace.GenerationSettings.GenerationRecipeOptions}"
                  SelectedItem="{Binding ImageSeriesWorkspace.GenerationSettings.SelectedGenerationRecipeOption, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName"
                  AutomationProperties.AutomationId="GenerationRecipeSelector"
                  AutomationProperties.Name="{Binding ImageSeriesWorkspace.GenerationSettings.GenerationRecipeLabel}"
                  MinHeight="28"
                  Margin="0,0,0,6" />
        <TextBlock Text="{Binding ImageSeriesWorkspace.GenerationSettings.StyleRecipeSummaryTitle}" FontWeight="SemiBold" Margin="0,4,0,4" />
        <TextBlock Text="{Binding ImageSeriesWorkspace.GenerationSettings.StyleRecipeSummaryText}"
                   TextWrapping="Wrap"
                   Foreground="#4B5563"
                   Margin="0,0,0,14" />
    </StackPanel>
</UserControl>
